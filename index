    <script>
        // Confetti Generator
        function createConfetti() {
            const container = document.getElementById('confetti-container');
            const colors = ['#FF6600', '#0055FF', '#FFCC00', '#FF3300', '#3366FF'];
            for (let i = 0; i < 35; i++) {
                const piece = document.createElement('div');
                piece.className = 'confetti-piece';
                piece.style.left = Math.random() * 100 + 'vw';
                piece.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                piece.style.width = Math.random() * 8 + 6 + 'px';
                piece.style.height = piece.style.width;
                piece.style.animationDuration = Math.random() * 3 + 2 + 's';
                piece.style.animationDelay = Math.random() * 5 + 's';
                container.appendChild(piece);
            }
        }
        createConfetti();

        // Countdown Timer targeting December 26 at 7:00 PM (19:00)
        function updateCountdown() {
            const now = new Date();
            let targetYear = now.getFullYear();
            let targetDate = new Date(targetYear, 11, 26, 19, 0, 0); 
            
            if (now > targetDate) {
                targetDate = new Date(targetYear + 1, 11, 26, 19, 0, 0);
            }

            const diff = targetDate - now;
            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
            const minutes = Math.floor((diff / 1000 / 60) % 60);
            const seconds = Math.floor((diff / 1000) % 60);

            document.getElementById('days').innerText = String(days).padStart(2, '0');
            document.getElementById('hours').innerText = String(hours).padStart(2, '0');
            document.getElementById('minutes').innerText = String(minutes).padStart(2, '0');
            document.getElementById('seconds').innerText = String(seconds).padStart(2, '0');
        }
        setInterval(updateCountdown, 1000);
        updateCountdown();

        // RSVP Form Submission Handler (Conectado a Google Sheets)
        async function handleRSVP(event) {
            event.preventDefault();
            
            const btn = event.target.querySelector('button[type="submit"]');
            const originalHtml = btn.innerHTML;
            
            // Cambiar el botón a estado de carga
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Enviando...';
            btn.disabled = true;

            const name = document.getElementById('guest-name').value;
            const adults = document.getElementById('adult-count').value;
            const children = document.getElementById('child-count').value;
            const message = document.getElementById('guest-message').value;

            // Construir el objeto de datos
            const data = {
                name: name,
                adults: adults,
                children: children,
                message: message
            };

            // URL de tu Web App de Apps Script
            const scriptURL = 'https://script.google.com/macros/s/AKfycbxyeqJPJJRLjCfdh4dj42CDMKhN0zlZSGwqvIQsfIbVFMsycTDpoiwPZK7RPvxG63R3wg/exec';

            if(name.trim() !== '') {
                try {
                    // Enviar los datos a Google Sheets
                    await fetch(scriptURL, {
                        method: 'POST',
                        // El content-type text/plain evita problemas de bloqueo por CORS en el navegador
                        headers: {
                            'Content-Type': 'text/plain;charset=utf-8',
                        },
                        body: JSON.stringify(data)
                    });

                    // Mostrar el mensaje de éxito y limpiar formulario
                    document.getElementById('rsvp-success').classList.remove('hidden');
                    event.target.reset();
                    setTimeout(() => {
                        document.getElementById('rsvp-success').scrollIntoView({ behavior: 'smooth' });
                    }, 100);
                } catch (error) {
                    console.error('Error al enviar:', error);
                    // Usar un modal o notificación visual en lugar de alert()
                    const successBox = document.getElementById('rsvp-success');
                    successBox.classList.remove('hidden', 'bg-green-100', 'text-green-800');
                    successBox.classList.add('bg-red-100', 'text-red-800');
                    successBox.innerHTML = '⚠️ Hubo un problema al enviar tu confirmación. Por favor, intenta de nuevo.';
                } finally {
                    // Restaurar el botón a su estado original
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            }
        }

        // Tone.js Sound Toggle & Cheerful Children's Birthday Party Melody
        let isPlaying = false;
        let synth, loop;

        async function toggleSound() {
            const icon = document.getElementById('sound-icon');
            const text = document.getElementById('sound-text');

            if (!isPlaying) {
                await Tone.start();
                
                synth = new Tone.Synth({
                    oscillator: { type: "sine" },
                    envelope: { attack: 0.02, decay: 0.1, sustain: 0.3, release: 0.5 }
                }).toDestination();

                const melody = [
                    "C4", "C4", "D4", "C4", "F4", "E4",
                    "C4", "C4", "D4", "C4", "G4", "F4",
                    "C4", "C4", "C5", "A4", "F4", "E4", "D4",
                    "A#4", "A#4", "A4", "F4", "G4", "F4"
                ];
                let index = 0;

                Tone.Transport.bpm.value = 135;

                loop = new Tone.Loop(time => {
                    synth.triggerAttackRelease(melody[index], "8n", time);
                    index = (index + 1) % melody.length;
                }, "4n").start(0);

                Tone.Transport.start();
                isPlaying = true;
                icon.className = "fa-solid fa-volume-xmark";
                text.innerText = "Apagar Música";
            } else {
                if(loop) loop.stop();
                Tone.Transport.stop();
                if(synth) synth.dispose();
                isPlaying = false;
                icon.className = "fa-solid fa-volume-high";
                text.innerText = "¡Activar Música!";
            }
        }
    </script>
